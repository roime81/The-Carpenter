# Control-plane settings. Copy to .env and use independent random secrets.
CARPENTER_ENV=development
CARPENTER_PORT=8000
CARPENTER_ADMIN_TOKEN=replace-with-a-separate-admin-secret
CARPENTER_AGENT_ENROLLMENT_TOKEN=replace-with-a-separate-node-worker-secret
CARPENTER_AGENT_STALE_SECONDS=90
CARPENTER_WORKER_LEASE_SECONDS=180
CARPENTER_COOKIE_SECURE=false

# Optional AI intent extraction. "none" uses deterministic prompt parsing.
CARPENTER_LLM_PROVIDER=none
CARPENTER_LLM_MODEL=llama3.1:8b
CARPENTER_LLM_BASE_URL=http://host.docker.internal:11434
CARPENTER_LLM_API_KEY=
CARPENTER_LLM_TIMEOUT_SECONDS=20

# Provider credentials are configured on the specific data-plane execution workers,
# NOT on the Carpenter control plane. See docs/DEPLOYMENT.md.
#
# Proxmox worker:
# CARPENTER_PROXMOX_URL=https://pve.example.com:8006
# CARPENTER_PROXMOX_TOKEN_ID=carpenter@pve!launcher
# CARPENTER_PROXMOX_TOKEN_SECRET=...
# CARPENTER_PROXMOX_NODE=pve-node-01
# CARPENTER_PROXMOX_TEMPLATE_VMID=9000
#
# Kubernetes execution worker:
# CARPENTER_KUBERNETES_API_URL=https://kubernetes.example.com:6443
# CARPENTER_KUBERNETES_TOKEN=...
#
# GAMGEE installer worker:
# CARPENTER_GAMGEE_INSTALLER_URL=https://gamgee-installer.example.com/api/v1/bootstrap
# CARPENTER_GAMGEE_INSTALLER_TOKEN=...

# The database is stored in the Docker named volume at /data/carpenter.db.
# For local execution, set CARPENTER_DB_PATH=./data/carpenter.db.
