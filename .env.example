# Copy to .env. Use independent, long random secrets.
CARPENTER_ENV=development
CARPENTER_PORT=8000
CARPENTER_ADMIN_TOKEN=replace-with-a-separate-admin-secret
CARPENTER_AGENT_ENROLLMENT_TOKEN=replace-with-a-separate-node-worker-secret
CARPENTER_AGENT_STALE_SECONDS=90
CARPENTER_WORKER_LEASE_SECONDS=90
CARPENTER_COOKIE_SECURE=false

# Optional intent extraction. "none" uses deterministic parsing.
CARPENTER_LLM_PROVIDER=none
CARPENTER_LLM_MODEL=llama3.1:8b
CARPENTER_LLM_BASE_URL=http://host.docker.internal:11434
CARPENTER_LLM_API_KEY=
CARPENTER_LLM_TIMEOUT_SECONDS=20

# Optional IaaS execution adapter: Proxmox VE API and a prepared cloud-init template.
CARPENTER_PROXMOX_URL=
CARPENTER_PROXMOX_TOKEN_ID=
CARPENTER_PROXMOX_TOKEN_SECRET=
CARPENTER_PROXMOX_NODE=
CARPENTER_PROXMOX_TEMPLATE_VMID=0

# Optional GAMGEE bootstrap adapter. Endpoint must implement docs/DEPLOYMENT.md contract.
CARPENTER_GAMGEE_INSTALLER_URL=
CARPENTER_GAMGEE_INSTALLER_TOKEN=

# Optional PaaS adapter: pre-existing Kubernetes API with a narrowly scoped service account.
CARPENTER_KUBERNETES_API_URL=
CARPENTER_KUBERNETES_TOKEN=

# The database is stored in the Docker named volume at /data/carpenter.db.
# For local execution, set CARPENTER_DB_PATH=./data/carpenter.db.
