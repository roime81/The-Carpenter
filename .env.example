# Copy to .env and replace the token with a long random value.
CARPENTER_ENV=development
CARPENTER_PORT=8000
CARPENTER_AGENT_ENROLLMENT_TOKEN=replace-with-a-long-random-secret
CARPENTER_COOKIE_SECURE=false

# Optional AI intent extraction. 'none' uses the deterministic fallback.
# For Ollama, run a model separately and set a reachable URL.
CARPENTER_LLM_PROVIDER=none
CARPENTER_LLM_MODEL=llama3.1:8b
CARPENTER_LLM_BASE_URL=http://127.0.0.1:11434
CARPENTER_LLM_API_KEY=
CARPENTER_LLM_TIMEOUT_SECONDS=20

# The database is stored in the Docker named volume at /data/carpenter.db.
# For local non-Docker execution, set CARPENTER_DB_PATH=./data/carpenter.db.
